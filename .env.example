# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env". This example file contains placeholders only.

# Address of the local practice blockchain (the node you start yourself).
# Check the URL that the node prints when it starts.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# The one account allowed to register models (the "designated account").
# Use an address from YOUR local practice blockchain only.
REGISTRAR_ADDRESS=<paste-local-address-here>

# Private key of that LOCAL practice account. Local practice keys must never be reused on any real network.
REGISTRAR_PRIVATE_KEY=<paste-local-test-key-here>

# Address where the contract was deployed on the local chain (changes each time you restart the chain).
CONTRACT_ADDRESS=<paste-deployed-address-here>
